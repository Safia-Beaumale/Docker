# PostgreSQL (obligatoires)
# Le mot de passe est placé dans une URL : éviter @ / : #
POSTGRES_USER=mmuser
POSTGRES_PASSWORD=change_me
POSTGRES_DB=mattermost

# Mattermost
MATTERMOST_VERSION=release-9.11
MM_SERVICESETTINGS_SITEURL=http://localhost

# Nginx
NGINX_PORT=80

# Bridge Discord (à remplir une fois Mattermost installé)
DISCORD_TOKEN=
DISCORD_SERVER=
DISCORD_CHANNEL=général
MATTERMOST_BOT_TOKEN=
MATTERMOST_TEAM=
MATTERMOST_CHANNEL=town-square
# BRIDGE_DEBUG=false
# TZ=Europe/Paris

# Stack de développement uniquement (docker-compose.dev.yml)
# DEV_DB_PORT=5432
# DEV_MATTERMOST_PORT=8065
# DEV_BRIDGE_PORT=8080
# DEV_ADMINER_PORT=8081